    "subtitle": {
      "az": "Hər gün təkrarlanan vərdişləri ifadə etmək üçün",
      "en": "For daily routines, habits, and permanent truths"
    },
    "explanation": {
      "az": "Hər gün və ya mütəmadi olaraq etdiyimiz hərəkətlər üçün fel olduğu kimi qalır (I read, they work). Yalnız He, She, It üçün felin sonuna -s və ya -es artırılır (He reads, She works).",
      "en": "We use the base verb for I, you, we, they (I wake up, they work). For he, she, it, we add -s or -es (He wakes up, She works).",
      "tr": "I, you, we, they için fiil yalın kalır. He, she, it için fiilin sonuna -s/-es takısı gelir.",
      "ru": "Для I, you, we, they глагол остается в начальной форме. Для he, she, it добавляется окончание -s или -es."
    },
    "formula": "He/She/It + Verb-s | I/You/We/They + Verb",
    "examples": [
      {
        "english": "I wake up at seven o'clock.",
        "translation": {
          "az": "Mən saat yeddidə oyanıram.",
          "en": "I wake up at seven o'clock.",
          "tr": "Saat yedide uyanırım.",
          "ru": "Я просыпаюсь в семь часов."
        }
      },
      {
        "english": "She reads books every evening.",
        "translation": {
          "az": "O, hər axşam kitab oxuyur.",
          "en": "She reads books every evening.",
          "tr": "O her akşam kitap okur.",
          "ru": "Она читает книги каждый вечер."
        }
      }
    ],
    "commonMistake": {
      "incorrect": "He wake up early.",
      "correct": "He wakes up early.",
      "explanation": {
        "az": "'He' (o) üçün felin sonuna '-s' əlavə olunmalıdır.",
        "en": "Remember the 3rd person singular '-s' ending."
      }
    }
  },
