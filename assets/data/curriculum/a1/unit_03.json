  "story": {
    "id": "s3",
    "title": "The Ant and the Grasshopper (Adapted)",
    "titleTranslation": {
      "az": "Qarışqa və Cırcırama (Ezop Təmsili)",
      "en": "The Ant and the Grasshopper",
      "tr": "Karınca ile Ağustos Böceği",
      "ru": "Муравей и кузнечик"
    },
    "cefr": "A1",
    "wordCount": 115,
    "content": "Every day, the little Ant wakes up early. He has breakfast quickly and goes to work.\n\nHe gathers grains of corn under the warm sun. He always works hard.\n\nA lazy Grasshopper sings and dances near the river. \"Why do you work all day, friend Ant? Come and play with me!\"\n\nThe Ant smiles. \"Winter is coming. I prepare my food every day.\"\n\nIn the evening, the Ant rests in his warm home. When cold winter arrives, the Ant is safe, but the Grasshopper is hungry.\n\nWork today brings peace tomorrow.",
    "vocabularyHighlights": ["wakes up", "breakfast", "work", "always", "evening", "early", "rest"]
  },
