  "story": {
    "id": "s1",
    "title": "Meet Lisa at University",
    "titleTranslation": {
      "az": "Universitetdə Lisa ilə Tanışlıq",
      "en": "Meet Lisa at University",
      "tr": "Üniversitede Lisa ile Tanışma",
      "ru": "Знакомство с Лизой в университете"
    },
    "cefr": "A1",
    "wordCount": 88,
    "content": "Hello! My name is Lisa. I am 22 years old, and I am a student.\n\nToday is a wonderful sunny day. I am in the library with my books.\n\nA friendly boy smiles and says, \"Hello! My name is Alex. Nice to meet you, Lisa.\"\n\nI smile back. \"Nice to meet you, Alex! Are you ready for our English class?\"\n\n\"Yes, I am!\" Alex replies cheerfully. \"We are friends now.\"\n\nWe are happy and ready to learn together.",
    "vocabularyHighlights": ["Hello", "name", "student", "Nice to meet you", "Friend", "Happy", "Ready"]
  },
