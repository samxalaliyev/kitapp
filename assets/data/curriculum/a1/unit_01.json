  "story": {
    "id": "s1",
    "title": "A New Friend at the Library",
    "titleTranslation": {
      "az": "Kitabxanada Yeni Dost",
      "en": "A New Friend at the Library",
      "tr": "Kütüphanede Yeni Bir Arkadaş",
      "ru": "Новый друг в библиотеке"
    },
    "cefr": "A1",
    "wordCount": 95,
    "content": "Tom is at the library today. It is a quiet morning. A friendly girl sits next to him.\n\n\"Hello,\" she says with a warm smile. \"My name is Sarah. Are you a student?\"\n\nTom smiles back. \"Yes, I am. Nice to meet you, Sarah. I am from Baku, and I love reading books here.\"\n\nSarah is pleased. \"Welcome to our city! We are friends now. Are you ready for class?\"\n\n\"Yes, I am!\" Tom replies. \"See you soon, Sarah.\"",
    "vocabularyHighlights": ["Hello", "name", "Nice to meet you", "Welcome", "friends", "ready", "See you soon"]
  },
