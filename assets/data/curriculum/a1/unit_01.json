  "iconName": "smile",
  "xpReward": 50,
  "grammarRule": {
    "id": "a1_gr_01",
    "title": {
      "az": "'To Be' Feli (am / is / are)",
      "en": "The Verb 'To Be' (am / is / are)",
      "tr": "'To Be' Fiili (am / is / are)",
      "ru": "Глагол 'To Be' (am / is / are)"
    },
    "subtitle": {
      "az": "İngilis dilində cümlələrin ən təməl sütunu",
      "en": "The foundational pillar of English sentences"
    },
    "explanation": {
      "az": "İngilis dilində hərəkət bildirməyən cümlələrdə 'olmaq' mənasını verən 'To Be' feli işlədilir. Şəxslərə görə 3 formaya bölünür: I am, You/We/They are, He/She/It is.",
      "en": "In sentences that describe a state or identity, English uses the verb 'To Be'. It changes form based on the subject: I am, You/We/They are, He/She/It is.",
      "tr": "İngilizce'de durum veya kimlik belirten cümlelerde 'To Be' kullanılır: I am, You/We/They are, He/She/It is.",
      "ru": "В предложениях, описывающих состояние или личность, используется глагол 'To Be': I am, You/We/They are, He/She/It is."
    },
    "formula": "Subject + am / is / are + Complement",
    "examples": [
      {
        "english": "I am a student.",
        "translation": {
          "az": "Mən tələbəyəm.",
          "en": "I am a student.",
          "tr": "Ben bir öğrenciyim.",
          "ru": "Я студент."
        }
      },
      {
        "english": "She is happy today.",
        "translation": {
          "az": "O, bu gün xoşbəxtdir.",
          "en": "She is happy today.",
          "tr": "O bugün mutlu.",
          "ru": "Она сегодня счастлива."
        }
      },
      {
        "english": "Are you from London?",
        "translation": {
          "az": "Sən Londondansan?",
          "en": "Are you from London?",
          "tr": "Sen Londra'dan mısın?",
          "ru": "Ты из Лондона?"
        }
      }
    ],
    "commonMistake": {
      "incorrect": "I is ready.",
      "correct": "I am ready.",
      "explanation": {
        "az": "'I' (mən) əvəzliyi ilə yalnız 'am' işlənir, heç vaxt 'is' işlənməz.",
        "en": "'I' only pairs with 'am', never 'is'."
      }
    }
  },
